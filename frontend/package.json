{
  "name": "timeplayed",
  "private": true,
  "version": "10.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "npx prettier --write src",
    "format-check": "npx prettier --check src",
    "generate-schema": "npx openapi-typescript http://localhost:8000/openapi.json -o src/api.schema.d.ts",
    "test:ts": "tsc --noEmit"
  },
  "dependencies": {
